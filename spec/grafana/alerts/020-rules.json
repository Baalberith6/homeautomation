      {
        "uid": "020-unit-down",
        "title": "Unit down",
        "orgID": 1,
        "folderUID": "alerts",
        "ruleGroup": "020",
        "condition": "C",
        "data": [
          {
            "refId": "A",
            "queryType": "",
            "relativeTimeRange": {
              "from": 300,
              "to": 0
            },
            "datasourceUid": "ceyru5v6xg3r4b",
            "model": {
              "refId": "A",
              "datasource": {
                "type": "influxdb",
                "uid": "ceyru5v6xg3r4b"
              },
              "query": "import \"strings\"\nfrom(bucket: \"default\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"systemd_units\" and r._field == \"active_code\")\n  |> filter(fn: (r) => r.name =~ /^0-.*\\.service$/ or r.name == \"telegraf.service\" or r.name == \"influxdb.service\")\n  |> map(fn: (r) => ({r with unit: strings.trimSuffix(v: r.name, suffix: \".service\")}))\n  |> group(columns: [\"unit\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"unit\"])",
              "intervalMs": 1000,
              "maxDataPoints": 43200
            }
          },
          {
            "refId": "B",
            "relativeTimeRange": {
              "from": 0,
              "to": 0
            },
            "datasourceUid": "__expr__",
            "model": {
              "refId": "B",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "type": "reduce",
              "expression": "A",
              "reducer": "last",
              "settings": {
                "mode": "dropNN"
              }
            }
          },
          {
            "refId": "C",
            "relativeTimeRange": {
              "from": 0,
              "to": 0
            },
            "datasourceUid": "__expr__",
            "model": {
              "refId": "C",
              "datasource": {
                "type": "__expr__",
                "uid": "__expr__"
              },
              "type": "threshold",
              "expression": "B",
              "conditions": [
                {
                  "evaluator": {
                    "type": "gt",
                    "params": [
                      0
                    ]
                  }
                }
              ]
            }
          }
        ],
        "for": "2m",
        "noDataState": "Alerting",
        "execErrState": "Alerting",
        "isPaused": false,
        "labels": {
          "change": "020"
        },
        "annotations": {
          "summary": "{{ $labels.unit }}: not active for 2 min"
        }
      },
