    {
      "id": 2,
      "type": "stat",
      "title": "Month-end projection",
      "description": "The cost of the current month so far divided by the elapsed share of the month. It ignores the time picker (028 S1).",
      "datasource": {
        "type": "influxdb",
        "uid": "ceyru5v6xg3r4b"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ceyru5v6xg3r4b"
          },
          "query": "import \"date\"\nimport \"timezone\"\noption location = timezone.location(name: \"Europe/Prague\")\nstart = date.truncate(t: now(), unit: 1mo)\nstop = date.add(d: 1mo, to: start)\nelapsed = float(v: int(v: now()) - int(v: start))\nmonth = float(v: int(v: stop) - int(v: start))\nfrom(bucket: \"ai\")\n  |> range(start: start)\n  |> filter(fn: (r) => r._measurement == \"ai_usage\" and r._field == \"cost_eur\")\n  |> group()\n  |> sum()\n  |> map(fn: (r) => ({r with _value: r._value * month / elapsed}))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              }
            ]
          },
          "decimals": 2,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      }
    },
