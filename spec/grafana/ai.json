          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ceyru5v6xg3r4b"
          },
          "query": "from(bucket: \"ai\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ai_usage\" and (r._field == \"id\" or r._field == \"cost_eur\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group(columns: [\"model\"])\n  |> reduce(identity: {calls: 0, cost_eur: 0.0}, fn: (r, accumulator) => ({\n      calls: accumulator.calls + 1,\n      cost_eur: accumulator.cost_eur + (if exists r.cost_eur then r.cost_eur else 0.0)}))\n  |> group()\n  |> sort(columns: [\"cost_eur\"], desc: true)"
        }
