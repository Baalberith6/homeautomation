    {
      "id": 1,
      "type": "stat",
      "title": "Total cost",
      "description": "The cost of every call to a cloud model in the time range, in EUR at the rate of prices.yaml (028 D6).",
      "datasource": {
        "type": "influxdb",
        "uid": "ceyru5v6xg3r4b"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "ceyru5v6xg3r4b"
          },
          "query": "from(bucket: \"ai\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ai_usage\" and r._field == \"cost_eur\")\n  |> group()\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
