            "uid": "ceyru5v6xg3r4b"
          },
          "query": "from(bucket: \"ai\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ai_usage\" and (r._field == \"input_tokens\" or r._field == \"cache_read_tokens\" or r._field == \"cache_write_tokens\"))\n  |> group()\n  |> reduce(identity: {input: 0.0, read: 0.0, write: 0.0}, fn: (r, accumulator) => ({\n      input: accumulator.input + (if r._field == \"input_tokens\" then float(v: r._value) else 0.0),\n      read: accumulator.read + (if r._field == \"cache_read_tokens\" then float(v: r._value) else 0.0),\n      write: accumulator.write + (if r._field == \"cache_write_tokens\" then float(v: r._value) else 0.0)}))\n  |> map(fn: (r) => ({_value: if r.input + r.read + r.write > 0.0 then r.read / (r.input + r.read + r.write) else 0.0}))"
        }
      ],
